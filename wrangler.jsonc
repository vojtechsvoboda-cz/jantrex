{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jantrex-podklady",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/soubor/*"]
  },
  "kv_namespaces": [
    // Vytvoř KV "jantrex-podklady" (Storage & Databases -> KV) a sem vlož jeho ID:
    { "binding": "PODKLADY", "id": "SEM_VLOZ_ID_KV" }
  ]
  // Heslo pro /odpovedi se nastavuje jako secret HESLO (Settings -> Variables and Secrets),
  // do souboru ho nepiš.
}
