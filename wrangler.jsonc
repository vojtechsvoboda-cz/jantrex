{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jantrex",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/soubor/*"]
  },
  "kv_namespaces": [
    { "binding": "PODKLADY", "id": "9fedbcfcf6024fbfac4dc68ff8c4fb91" }
  ]
  // Heslo pro /odpovedi: secret HESLO v Settings -> Variables and Secrets (do souboru ho nepiš)
}
